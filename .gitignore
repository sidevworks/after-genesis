# ---------------------------------------------------------------------------
# SECRETS — never commit. See docs/threat-model.md.
# The canonical world must be reproducible from public data alone; credentials
# are never part of that data.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Service-account / admin credentials.
# Firebase names downloaded keys `<project>-firebase-adminsdk-<id>.json`, which
# matches neither "serviceAccount" nor "service-account" — the obvious patterns
# miss the actual filename the console gives you. Match the real shapes.
*firebase-adminsdk*.json
*adminsdk*.json
*serviceAccount*.json
*service-account*.json
*-key.json
credentials.json
gha-creds-*.json
# Belt and braces: any JSON at the repo root is credential-shaped until proven
# otherwise. Config files that genuinely belong here are re-included below.
/*.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.base.json
!/vercel.json
!/firebase.json
!/firestore.indexes.json

# Build / deps
node_modules/
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo

# Test / coverage
coverage/
.vitest/
playwright-report/
test-results/
firebase-debug.log

# Video masters. The web-encoded intro that the landing page actually serves
# lives at apps/spectator/public/intro.mp4 and IS committed — Vercel builds from
# the repository, so an uncommitted asset is a 404 in production. Full-bitrate
# masters are not; keep them out of history.
/intro.mp4
/exports/*.mp4

# 3D character masters and the copy staged into the spectator's public tree.
# ~192 MB each, and the same files twice. Unlike intro.mp4 above these are NOT
# committed: git history is permanent and Vercel would ship a quarter-gigabyte
# of static assets to every spectator. They belong in Cloud Storage for Firebase
# (claude.md §3), served compressed. Until that lands the observatory falls back
# to the procedural characters in observatory-character-model.ts — the loader
# already resolves null on a failed fetch, so this degrades rather than breaks.
/3D Models/
apps/spectator/public/character-models/

# Compressed models staged for upload by scripts/publish-assets.mjs.
# Regenerable from the masters above, so it is built, never committed.
apps/spectator/.assets-dist/

# Local world data (simulation output is regenerable from seed + model log)
.worlds/
.after-genesis/
*.local.jsonl

# The world the dev controller drives, as published for the spectator to read.
# Deliberately not src/fixtures/: those are the committed demo the public pages
# render and the tests assert against, and a dev reset must not redefine them.
apps/spectator/.dev-world/

# Audio rendered from the dev world. Regenerable from canonical dialogue, and
# derived from throwaway inhabitants, so it is never committed and never ships.
apps/spectator/public/voice/month/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.claude/
.vscode/*
!.vscode/extensions.json
.aider*
