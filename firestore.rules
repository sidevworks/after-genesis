rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public projections contain no private cognition and are generated only by
    // the trusted runtime. Spectators may read them and may never write them.
    match /worlds/{worldId}/public/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // A minimal world header is public for health, head hash and freeze status.
    match /worlds/{worldId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything canonical, operational and private is inaccessible to client
    // SDK identities. The Admin SDK uses IAM and bypasses these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
