# Copy to .env and fill in. NEVER commit .env — see .gitignore and docs/threat-model.md.

# --- Cognition (§3). Model IDs are configuration, never hardcoded. ---
GEMINI_API_KEY=
AG_MODEL_ROUTINE=gemini-2.5-flash-lite
AG_MODEL_DELIBERATE=gemini-2.5-flash

# --- Media (§21). Read-only with respect to the world. ---
ELEVENLABS_API_KEY=

# --- Firebase. The spectator app receives PUBLIC web config only. ---
FIREBASE_STORAGE_BUCKET_ID=
# Simulation runtime only. MUST NOT be set in the Vercel frontend project (§17).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Cost control (§15). The world pauses rather than overspending. ---
AG_SPEND_LIMIT_DAILY_USD=25
AG_SPEND_LIMIT_TOTAL_USD=500
