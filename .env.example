# Copy to .env and fill in. NEVER commit .env — see .gitignore and docs/threat-model.md.

# --- Cognition (§3). Model IDs are configuration, never hardcoded. ---
GEMINI_API_KEY=
AG_MODEL_ROUTINE=gemini-3.6-flash
AG_MODEL_DELIBERATE=gemini-3.6-flash

# --- Media (§21). Read-only with respect to the world. ---
# Consumed only by the offline renderer (packages/media). The API key is never
# bundled into the spectator app: see packages/media/README.md.
ELEVENLABS_API_KEY=

# Each key must be UNIQUE — a repeated key is not a list, and every loader keeps
# only the last assignment. Pools are comma-separated, ten entries per sex.
# Pool position N is canonical voice handle N (voice_m01 = first male entry), so
# entries must never be reordered or removed once a world is live.
ELEVENLABS_VOICE_NARRATION=
ELEVENLABS_VOICES_MALE=
ELEVENLABS_VOICES_FEMALE=
ELEVENLABS_VOICE_CHILD_MALE=
ELEVENLABS_VOICE_CHILD_FEMALE=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Canonical maturity below which an inhabitant renders with a child voice.
MEDIA_CHILD_MATURITY_BELOW=3

# --- Firebase. The spectator app receives PUBLIC web config only. ---
FIREBASE_STORAGE_BUCKET_ID=

# Firebase WEB app config, used by the spectator app for sign-in (Google, email
# and anonymous "guest" accounts). Copy these from:
#   Firebase console -> Project settings -> General -> Your apps -> Web app -> SDK setup
#
# NEXT_PUBLIC_ means Next inlines the value into the browser bundle at build
# time. That is correct and intended: these six values identify a project and
# authorise nothing. Access is decided by Firestore security rules and by the
# Authentication authorised-domain list, never by keeping an apiKey secret.
#
# These are the ONLY Firebase values that may exist in the Vercel frontend
# project. A service-account JSON key is NOT a substitute for them and must
# never be placed here, in Vercel, or anywhere the browser bundle can reach —
# it is the runtime's canonical write credential (§17).
#
# Sign-in also requires, in the Firebase console:
#   Authentication -> Sign-in method -> enable Google, Email/Password, Anonymous
#   Authentication -> Settings -> Authorised domains -> add the Vercel domains
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Simulation runtime only. MUST NOT be set in the Vercel frontend project (§17).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Runtime / Cloud Tasks (backend only; use attached IAM in production). ---
GOOGLE_CLOUD_PROJECT=
AG_TASKS_LOCATION=
AG_TASKS_QUEUE=
AG_TURN_WORKER_URL=
AG_TASKS_SERVICE_ACCOUNT=
AG_SOURCE_COMMIT=
AG_DEPLOYED_DIGEST=

# --- Cost control (§15). The world pauses rather than overspending. ---
AG_SPEND_LIMIT_DAILY_USD=25
AG_SPEND_LIMIT_TOTAL_USD=500
