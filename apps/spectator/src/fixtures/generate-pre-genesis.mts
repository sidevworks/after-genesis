/**
 * Generates `pre-genesis.json`: the world before anybody lives in it.
 *
 * This is what the spectator serves when there is no world to show — before
 * Genesis, and in any build that is not pointed at a running world. It is a map
 * and nothing else: no inhabitants, no events, no organisations, no artifacts,
 * no economy, no lineage.
 *
 * Nothing here is derived from an inhabitant. The terrain is a pure function of
 * the published Genesis seed, so this file can be regenerated by anyone holding
 * that seed and compared byte for byte. It carries no history because no
 * history has happened yet.
 *
 * Run: npx tsx src/fixtures/generate-pre-genesis.mts
 */

import { writeFileSync } from "node:fs";
import { generateMap } from "@after-genesis/core";

/** Must match the Genesis configuration the world will actually launch with. */
const GENESIS_SEED = "after-genesis-public-demo-seed-v1";
const WIDTH = 32;
const HEIGHT = 32;
const SCHEMA_VERSION = "world-rules/1.4.0";
const WORLD_ID = "AG-1";

const map = generateMap(GENESIS_SEED, WIDTH, HEIGHT);

const tiles = [];
for (let y = 0; y < HEIGHT; y++) {
  for (let x = 0; x < WIDTH; x++) {
    const terrain = map.terrain[y * WIDTH + x];
    tiles.push({ x, y, terrain, fertility: 0, deposit: null });
  }
}

const world = {
  generatedBy: "src/fixtures/generate-pre-genesis.mts",
  note:
    "The world before Genesis. Terrain is a pure function of the published seed; " +
    "everything else is empty because nothing has happened yet. No part of this " +
    "file is derived from an inhabitant.",
  summary: {
    worldId: WORLD_ID,
    genesisSeed: GENESIS_SEED,
    schemaVersion: SCHEMA_VERSION,
    status: "awaiting-genesis",
    simTime: 0,
    lastEventAt: null,
    mapWidth: WIDTH,
    mapHeight: HEIGHT,
    population: { living: 0, deceased: 0, total: 0, byGeneration: [] },
    structureCount: 0,
    organisationCount: 0,
    artifactCount: 0,
    eventCount: 0,
    chainHead: null,
    stateChecksum: null,
    sourceCommit: null,
    imageDigest: null,
  },
  map: { width: WIDTH, height: HEIGHT, genesisSeed: GENESIS_SEED, tiles, structures: [], occupants: [] },
  inhabitants: [],
  events: [],
  organisations: [],
  artifacts: [],
  economy: { currencies: [], ledger: [], trades: [], contracts: [], nonMonetaryTransferCount: 0 },
  lineage: { nodes: [], rootIds: [], generationCount: 0 },
  audit: {
    stateChecksum: null,
    sourceCommit: null,
    imageDigest: null,
    schemaVersion: SCHEMA_VERSION,
    genesisSeed: GENESIS_SEED,
    // No history has been replayed because none exists.
    lastReplay: null,
    anchors: [],
    // Policy, not history: what the verifier does and what is withheld are true
    // before the first event as much as after it.
    verifier: {
      repository: "github.com/sidevworks/after-genesis",
      command: `npx @after-genesis/verify --export world-${WORLD_ID}.jsonl --seed ${GENESIS_SEED}`,
      exportUrl: null,
      notes: [
        "The verifier recomputes every event hash from the exported log and checks each event's prevHash against the previous event's recomputed hash.",
        "It then replays the log from Genesis using the recorded model responses and compares the reconstructed state checksum with the published one.",
        "It requires no credentials. Nothing it does can write to the world.",
        "A mismatch at any sequence number is reported with that sequence number rather than repaired.",
        "There is nothing to verify yet: this world has not begun.",
      ],
    },
    withheld: [
      {
        category: "Private cognition transcripts",
        reason:
          "An inhabitant's prompt and reasoning are not observable by other inhabitants and are not published while it lives.",
        releaseCondition: "Released with the inhabitant's death record.",
      },
      {
        category: "Private memories and goals",
        reason:
          "Publishing them would make every inhabitant's interior legible to every spectator, and to anyone who could relay it inward.",
        releaseCondition: "Released with the inhabitant's death record.",
      },
      {
        category: "Private conversations",
        reason: "Recorded canonically but visible only to participants.",
        releaseCondition: "Released when every participant has died.",
      },
      {
        category: "Infrastructure identifiers and credentials",
        reason:
          "Security. No inhabitant and no spectator may acquire infrastructure permissions.",
        releaseCondition: "Never released.",
      },
    ],
  },
};

const output = new URL("./pre-genesis.json", import.meta.url);
writeFileSync(output, `${JSON.stringify(world, null, 1)}\n`, "utf8");

/**
 * The same emptiness in the shape the Observatory and Watch views read.
 *
 * They render a camera-tracked run rather than a world snapshot, so they need
 * their own empty: same map, no inhabitants, no events, nothing to film.
 */
const run = {
  exportVersion: 2,
  disclosurePolicy:
    "Canonical public and local physical facts, plus physically observable activity " +
    "envelopes. Private and participant-only contents are withheld.",
  disclosure: {
    policyVersion: 2,
    envelope:
      "No activity has occurred. Envelopes appear here once inhabitants act (claude.md §11E).",
    contents:
      "No contents exist to disclose or withhold. Withheld contents are never reconstructed, " +
      "summarised or inferred.",
  },
  world: {
    id: WORLD_ID,
    seed: GENESIS_SEED,
    schemaVersion: 2,
    simTime: 0,
    sequence: 0,
    checksum: "",
    chainHead: "",
  },
  map: { width: WIDTH, height: HEIGHT, terrain: [...map.terrain] },
  inhabitants: [],
  structures: [],
  artifacts: [],
  activities: [],
  events: [],
};

const runOutput = new URL("./pre-genesis-run.json", import.meta.url);
writeFileSync(runOutput, `${JSON.stringify(run, null, 1)}\n`, "utf8");

process.stdout.write(
  `Wrote a ${WIDTH}x${HEIGHT} pre-Genesis world and run (0 inhabitants, 0 events) to ` +
    `${output.pathname} and ${runOutput.pathname}\n`,
);
