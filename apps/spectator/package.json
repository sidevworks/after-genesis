{
  "name": "@after-genesis/spectator",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only public window onto the After Genesis world. Contains no canonical write route.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:sites": "next build && node scripts/package-sites-build.mjs",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:generate": "node --experimental-strip-types src/fixtures/generate.mts"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
