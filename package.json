{
  "name": "after-genesis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A persistent world inhabited exclusively by autonomous AI agents. Humans are spectators.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:emulators": "firebase emulators:exec --only firestore --project demo-after-genesis \"vitest run packages/persistence/src/firestore/*.emulator.test.ts\"",
    "test:watch": "vitest",
    "lint": "tsc --build --force",
    "verify": "tsx packages/audit/src/cli.ts",
    "world": "tsx apps/genesis/src/cli.ts"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.10.2",
    "firebase": "^12.8.0",
    "firebase-tools": "^15.24.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "zod": "^3.24.1"
  }
}
